# doğrula_tr: form alanlarını doğrulama ve biçimlendirme.
#   kullan "doğrula_tr"
#   tc_kimlik_geçerli_mi("10000000146")'yı yaz.      # doğru
#   iban_biçimle("tr330006100519786457841326")'yı yaz.  # TR33 0006 1005 1978 6457 8413 26
#   telefon_biçimle("+90 532 123 45 67")'yi yaz.     # 0532 123 45 67
#   şifre_eksikleri("abc")'yi yaz.                   # ["en az 8 karakter olmalı", …]
#
# Algoritmalar yalnızca biçimi ve denetim hanelerini sınar; numaranın gerçekten birine ait
# olduğunu göstermez (bunun için resmi servisler gerekir).

işlev yalnız_rakam_mı(m: metin) -> mantık:
    eğer m == "" ise:
        döndür yanlış
    her c için kodlar(m)'den:
        eğer c < 48 veya c > 57 ise:
            döndür yanlış
    döndür doğru

işlev rakamlar(m: metin) -> liste<sayı>:
    l: liste<sayı> = []
    her c için kodlar(m)'den:
        (c - 48)'i l'ye ekle.
    döndür l

# Boşluk, tire, nokta ve parantezleri atar
işlev sadeleştir(m: metin) -> metin:
    s = kırp(m)
    her c için [" ", "-", ".", "(", ")", "/", "\t"]'den:
        s = değiştir(s, c, "")
    döndür s

# ---------------------------------------------------------------------------
# T.C. kimlik numarası: 11 hane, ilki 0 değil; 10. ve 11. haneler denetim hanesidir.

işlev tc_kimlik_geçerli_mi(no: metin) -> mantık:
    m = sadeleştir(no)
    eğer uzunluk(m) != 11 veya yalnız_rakam_mı(m) == yanlış veya m[0] == "0" ise:
        döndür yanlış
    d = rakamlar(m)
    tek = d[0] + d[2] + d[4] + d[6] + d[8]
    çift = d[1] + d[3] + d[5] + d[7]
    eğer ((tek * 7 - çift) % 10 + 10) % 10 != d[9] ise:
        döndür yanlış
    t = 0
    her i için 0'dan 9'a kadar:
        t += d[i]
    döndür t % 10 == d[10]

# ---------------------------------------------------------------------------
# Vergi kimlik numarası (VKN): 10 hane, son hane denetim hanesi (Gelir İdaresi algoritması)

işlev vergi_no_geçerli_mi(no: metin) -> mantık:
    m = sadeleştir(no)
    eğer uzunluk(m) != 10 veya yalnız_rakam_mı(m) == yanlış ise:
        döndür yanlış
    d = rakamlar(m)
    t = 0
    her i için 0'dan 8'e kadar:
        x = (d[i] + 9 - i) % 10
        üs_ = 1
        her j için 1'den 9 - i'ye kadar:
            üs_ = üs_ * 2
        v = (x * üs_) % 9
        eğer x != 0 ve v == 0 ise:
            v = 9
        t += v
    döndür (10 - t % 10) % 10 == d[9]

# ---------------------------------------------------------------------------
# IBAN (ISO 13616, mod 97). Türkiye IBAN'ı 26 karakterdir: TR + 2 denetim + 22 hane.

işlev iban_sadeleştir(iban: metin) -> metin:
    # Türkçe büyük harf dönüşümü "i"yi "İ" yapar; IBAN Latin harfleri kullanır.
    döndür büyük_harf(değiştir(sadeleştir(iban), "i", "I"))

işlev iban_geçerli_mi(iban: metin) -> mantık:
    m = iban_sadeleştir(iban)
    n = uzunluk(m)
    eğer n < 15 veya n > 34 ise:
        döndür yanlış
    eğer parça(m, 0, 2) == "TR" ve n != 26 ise:
        döndür yanlış
    düzen = parça(m, 4, n - 4) + parça(m, 0, 4)
    kalan = 0
    her c için kodlar(düzen)'den:
        eğer c >= 48 ve c <= 57 ise:
            kalan = (kalan * 10 + c - 48) % 97
        değilse eğer c >= 65 ve c <= 90 ise:
            kalan = (kalan * 100 + c - 55) % 97
        değilse:
            döndür yanlış
    eğer (kodlar(m)[0] < 65 veya kodlar(m)[0] > 90 veya kodlar(m)[1] < 65 veya kodlar(m)[1] > 90) ise:
        döndür yanlış
    döndür kalan == 1

# "TR33 0006 1005 1978 6457 8413 26"
işlev iban_biçimle(iban: metin) -> metin:
    m = iban_sadeleştir(iban)
    p: liste<metin> = []
    i = 0
    i < uzunluk(m) olduğu sürece:
        parça(m, i, 4)'ü p'ye ekle.
        i += 4
    döndür birleştir(p, " ")

# ---------------------------------------------------------------------------
# Telefon (Türkiye). +90, 0090, 90 ve baştaki 0 kabul edilir.

# 10 haneli ulusal numara ("5321234567"); geçersizse ""
işlev telefon_sadeleştir(no: metin) -> metin:
    m = sadeleştir(no)
    eğer başlar(m, "+90") ise:
        m = parça(m, 3, uzunluk(m) - 3)
    değilse eğer başlar(m, "0090") ise:
        m = parça(m, 4, uzunluk(m) - 4)
    değilse eğer başlar(m, "90") ve uzunluk(m) == 12 ise:
        m = parça(m, 2, 10)
    eğer başlar(m, "0") ise:
        m = parça(m, 1, uzunluk(m) - 1)
    eğer uzunluk(m) != 10 veya yalnız_rakam_mı(m) == yanlış ise:
        döndür ""
    # Alan kodları 2, 3, 4 (sabit hat), 5 (cep) ve 8 (444, 850…) ile başlar
    eğer içerir("23458", m[0]) == yanlış ise:
        döndür ""
    döndür m

işlev telefon_geçerli_mi(no: metin) -> mantık:
    döndür telefon_sadeleştir(no) != ""

işlev cep_telefonu_mu(no: metin) -> mantık:
    m = telefon_sadeleştir(no)
    döndür m != "" ve m[0] == "5"

# "0532 123 45 67"; geçersizse olduğu gibi döner
işlev telefon_biçimle(no: metin) -> metin:
    m = telefon_sadeleştir(no)
    eğer m == "" ise:
        döndür no
    döndür "0" + parça(m, 0, 3) + " " + parça(m, 3, 3) + " " + parça(m, 6, 2) + " " + parça(m, 8, 2)

# Uluslararası biçim (SMS servisleri için): "+905321234567"
işlev telefon_uluslararası(no: metin) -> metin:
    m = telefon_sadeleştir(no)
    eğer m == "" ise:
        döndür ""
    döndür "+90" + m

# ---------------------------------------------------------------------------
# Araç plakası: "34 ABC 123". İl kodu 01–81; harflerde Q, W, X ve Türkçe harfler yoktur.
# 1 harf → 4–5 rakam, 2 harf → 3–4 rakam, 3 harf → 2–3 rakam.

işlev plaka_parçaları(plaka: metin) -> liste<metin>:
    m = büyük_harf(değiştir(değiştir(kırp(plaka), " ", ""), "-", ""))
    k = kodlar(m)
    i = 0
    i < uzunluk(k) ve k[i] >= 48 ve k[i] <= 57 olduğu sürece:
        i += 1
    j = i
    j < uzunluk(k) ve k[j] >= 65 ve k[j] <= 90 olduğu sürece:
        j += 1
    döndür [parça(m, 0, i), parça(m, i, j - i), parça(m, j, uzunluk(k) - j)]

işlev plaka_geçerli_mi(plaka: metin) -> mantık:
    p = plaka_parçaları(plaka)
    il = p[0]
    harf = p[1]
    no = p[2]
    eğer uzunluk(il) != 2 veya yalnız_rakam_mı(no) == yanlış ise:
        döndür yanlış
    eğer sayı(il) < 1 veya sayı(il) > 81 ise:
        döndür yanlış
    her c için harfler(harf)'ten:
        eğer içerir("QWX", c) ise:
            döndür yanlış
    h = uzunluk(harf)
    r = uzunluk(no)
    döndür (h == 1 ve r >= 4 ve r <= 5) veya (h == 2 ve r >= 3 ve r <= 4) veya (h == 3 ve r >= 2 ve r <= 3)

işlev plaka_biçimle(plaka: metin) -> metin:
    eğer plaka_geçerli_mi(plaka) == yanlış ise:
        döndür plaka
    p = plaka_parçaları(plaka)
    döndür p[0] + " " + p[1] + " " + p[2]

# ---------------------------------------------------------------------------
# Posta kodu: 5 hane, ilk iki hane il kodu (01–81)

işlev posta_kodu_geçerli_mi(kod: metin) -> mantık:
    m = kırp(kod)
    döndür uzunluk(m) == 5 ve yalnız_rakam_mı(m) ve sayı(parça(m, 0, 2)) >= 1 ve sayı(parça(m, 0, 2)) <= 81

# ---------------------------------------------------------------------------
# E-posta ve adres

işlev e_posta_geçerli_mi(adres: metin) -> mantık:
    m = kırp(adres)
    eğer uzunluk(m) > 254 veya içerir(m, " ") ise:
        döndür yanlış
    p = böl(m, "@")
    eğer uzunluk(p) != 2 veya p[0] == "" veya uzunluk(p[0]) > 64 ise:
        döndür yanlış
    alan = p[1]
    eğer içerir(alan, ".") == yanlış veya başlar(alan, ".") veya biter(alan, ".") veya içerir(alan, "..") ise:
        döndür yanlış
    eğer başlar(p[0], ".") veya biter(p[0], ".") veya içerir(p[0], "..") ise:
        döndür yanlış
    parçalar = böl(alan, ".")
    son = parçalar[uzunluk(parçalar) - 1]
    eğer uzunluk(son) < 2 ise:
        döndür yanlış
    her c için harfler(alan)'dan:
        eğer içerir("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-", c) == yanlış ise:
            döndür yanlış
    döndür doğru

işlev url_geçerli_mi(adres: metin) -> mantık:
    m = kırp(adres)
    eğer içerir(m, " ") ise:
        döndür yanlış
    k = ""
    eğer başlar(m, "https://") ise:
        k = parça(m, 8, uzunluk(m) - 8)
    değilse eğer başlar(m, "http://") ise:
        k = parça(m, 7, uzunluk(m) - 7)
    değilse:
        döndür yanlış
    alan = böl(böl(böl(k, "/")[0], "?")[0], "#")[0]
    alan = böl(alan, ":")[0]
    döndür alan != "" ve (içerir(alan, ".") veya alan == "localhost") ve başlar(alan, ".") == yanlış ve biter(alan, ".") == yanlış

# ---------------------------------------------------------------------------
# Banka kartı: Luhn denetimi ve kart türü (kart numarası saklamayın; yalnızca biçim sınanır)

işlev kart_no_geçerli_mi(no: metin) -> mantık:
    m = sadeleştir(no)
    eğer uzunluk(m) < 12 veya uzunluk(m) > 19 veya yalnız_rakam_mı(m) == yanlış ise:
        döndür yanlış
    d = rakamlar(m)
    t = 0
    n = uzunluk(d)
    her i için 0'dan n - 1'e kadar:
        x = d[n - 1 - i]
        eğer i % 2 == 1 ise:
            x = x * 2
            eğer x > 9 ise:
                x -= 9
        t += x
    döndür t % 10 == 0

# "Visa", "Mastercard", "American Express", "Troy" ya da ""
işlev kart_türü(no: metin) -> metin:
    m = sadeleştir(no)
    eğer yalnız_rakam_mı(m) == yanlış veya uzunluk(m) < 4 ise:
        döndür ""
    iki = sayı(parça(m, 0, 2))
    dört = sayı(parça(m, 0, 4))
    eğer başlar(m, "9792") ise:
        döndür "Troy"
    eğer başlar(m, "4") ise:
        döndür "Visa"
    eğer (iki >= 51 ve iki <= 55) veya (dört >= 2221 ve dört <= 2720) ise:
        döndür "Mastercard"
    eğer iki == 34 veya iki == 37 ise:
        döndür "American Express"
    döndür ""

# Son dört hane dışını gizler: "**** **** **** 1234"
işlev kart_gizle(no: metin) -> metin:
    m = sadeleştir(no)
    eğer uzunluk(m) < 4 ise:
        döndür m
    döndür "**** **** **** " + parça(m, uzunluk(m) - 4, 4)

# ---------------------------------------------------------------------------
# Şifre gücü

# Şifrenin karşılamadığı kurallar (boşsa şifre yeterince güçlü)
işlev şifre_eksikleri(şifre: metin) -> liste<metin>:
    e: liste<metin> = []
    büyük_var = yanlış
    küçük_var = yanlış
    rakam_var = yanlış
    işaret_var = yanlış
    her c için harfler(şifre)'den:
        eğer içerir("0123456789", c) ise:
            rakam_var = doğru
        değilse eğer büyük_harf(c) != küçük_harf(c) ise:
            eğer c == büyük_harf(c) ise:
                büyük_var = doğru
            değilse:
                küçük_var = doğru
        değilse:
            işaret_var = doğru
    eğer uzunluk(şifre) < 8 ise:
        "en az 8 karakter olmalı"'yı e'ye ekle.
    eğer büyük_var == yanlış ise:
        "en az bir büyük harf içermeli"'yi e'ye ekle.
    eğer küçük_var == yanlış ise:
        "en az bir küçük harf içermeli"'yi e'ye ekle.
    eğer rakam_var == yanlış ise:
        "en az bir rakam içermeli"'yi e'ye ekle.
    döndür e

işlev şifre_güçlü_mü(şifre: metin) -> mantık:
    döndür uzunluk(şifre_eksikleri(şifre)) == 0

# 0 (çok zayıf) – 4 (çok güçlü)
işlev şifre_puanı(şifre: metin) -> sayı:
    p = 0
    n = uzunluk(şifre)
    eğer n >= 8 ise:
        p += 1
    eğer n >= 12 ise:
        p += 1
    eksik = uzunluk(şifre_eksikleri(şifre))
    eğer eksik == 0 ise:
        p += 1
    işaretli = yanlış
    her c için harfler(şifre)'den:
        eğer büyük_harf(c) == küçük_harf(c) ve içerir("0123456789", c) == yanlış ise:
            işaretli = doğru
    eğer işaretli ve n >= 8 ise:
        p += 1
    # Çok bilinen şifreler
    yaygın = ["12345678", "123456789", "password", "şifre123", "qwerty123", "11111111", "abc12345", "Password1"]
    her y için yaygın'dan:
        eğer küçük_harf(şifre) == küçük_harf(y) ise:
            döndür 0
    eğer p > 4 ise:
        p = 4
    döndür p

işlev şifre_gücü_yazısı(şifre: metin) -> metin:
    döndür ["çok zayıf", "zayıf", "orta", "güçlü", "çok güçlü"][şifre_puanı(şifre)]
