kullan "insancıl.ohc"

işlev sına_sayı_yazıyla():
    eşit_olmalı(sayı_yazıyla(0), "sıfır")
    eşit_olmalı(sayı_yazıyla(7), "yedi")
    eşit_olmalı(sayı_yazıyla(10), "on")
    eşit_olmalı(sayı_yazıyla(100), "yüz")
    eşit_olmalı(sayı_yazıyla(1000), "bin")
    eşit_olmalı(sayı_yazıyla(1234), "bin iki yüz otuz dört")
    eşit_olmalı(sayı_yazıyla(2026), "iki bin yirmi altı")
    eşit_olmalı(sayı_yazıyla(101001), "yüz bir bin bir")
    eşit_olmalı(sayı_yazıyla(1000000), "bir milyon")
    eşit_olmalı(sayı_yazıyla(3000000005), "üç milyar beş")
    eşit_olmalı(sayı_yazıyla(-45), "eksi kırk beş")

işlev sına_para_yazıyla():
    eşit_olmalı(para_yazıyla(1250.5), "bin iki yüz elli lira elli kuruş")
    eşit_olmalı(para_yazıyla(1.0), "bir lira")
    eşit_olmalı(para_yazıyla(0.99), "sıfır lira doksan dokuz kuruş")

