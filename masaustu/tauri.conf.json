{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orhunca Stüdyo",
  "mainBinaryName": "orhunca-studyo",
  "version": "0.5.0",
  "identifier": "dev.orhunca.studyo",
  "build": {
    "frontendDist": "bos"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "Orhunca",
    "copyright": "Orhunca geliştiricileri",
    "shortDescription": "Türkçe programlama dili Orhunca için geliştirme ortamı",
    "longDescription": "Orhunca Stüdyo: Türkçe söz dizimiyle yazılan Orhunca programlarını düzenleme, derleme, çalıştırma ve web uygulamalarını canlı önizleme ortamı.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
