# Kayıtlar SQLite veritabanına (veri/orhunca.sqlite) yazılır; DB Browser for SQLite ile açılabilir.
# Başka bir veritabanı için bu satırı değiştirin:
#   ORHUNCA_VERITABANI=sqlserver://localhost\SQLEXPRESS/panel      (SQL Server; SSMS ile açılır)
#   ORHUNCA_VERITABANI=postgresql://kullanıcı:şifre@localhost/panel
#   ORHUNCA_VERITABANI=mysql://kullanıcı:şifre@localhost/panel
# Satır silinirse kayıtlar veri/ klasöründeki JSON dosyalarına yazılır.
ORHUNCA_VERITABANI=sqlite
