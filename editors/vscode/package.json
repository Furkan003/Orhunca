{
  "name": "orhunca",
  "displayName": "Orhunca",
  "description": "Türkçe tabanlı programlama dili Orhunca için sözdizimi renklendirme, hata gösterimi, tamamlama ve biçimlendirme, hata ayıklama (kesme noktaları, koşullu kesme, günlük noktası); .ohchtml görünümleri",
  "version": "0.6.0",
  "publisher": "orhunca",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/furkan003/orhunca"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Debuggers"
  ],
  "keywords": [
    "orhunca",
    "türkçe",
    "turkish",
    "programlama"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:orhunca",
    "onLanguage:orhunca-html",
    "onDebugResolve:orhunca",
    "onDebugDynamicConfigurations:orhunca"
  ],
  "contributes": {
    "languages": [
      {
        "id": "orhunca",
        "aliases": [
          "Orhunca",
          "orhunca"
        ],
        "extensions": [
          ".ohc"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "orhunca-html",
        "aliases": [
          "Orhunca HTML",
          "ohchtml"
        ],
        "extensions": [
          ".ohchtml"
        ],
        "configuration": "./language-configuration-html.json"
      },
      {
        "id": "orhunca-proje",
        "aliases": [
          "Orhunca projesi"
        ],
        "extensions": [
          ".ohcproj"
        ]
      }
    ],
    "grammars": [
      {
        "language": "orhunca",
        "scopeName": "source.orhunca",
        "path": "./syntaxes/orhunca.tmLanguage.json"
      },
      {
        "language": "orhunca-html",
        "scopeName": "text.html.orhunca",
        "path": "./syntaxes/orhunca-html.tmLanguage.json",
        "embeddedLanguages": {
          "source.orhunca": "orhunca",
          "source.css": "css",
          "source.js": "javascript"
        }
      }
    ],
    "commands": [
      {
        "command": "orhunca.calistir",
        "title": "Orhunca: Çalıştır",
        "icon": "$(play)"
      },
      {
        "command": "orhunca.denetle",
        "title": "Orhunca: Denetle"
      },
      {
        "command": "orhunca.studyo",
        "title": "Orhunca: Stüdyo'yu aç"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "orhunca.calistir",
          "when": "editorLangId == orhunca",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "orhunca.calistir",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == orhunca"
      }
    ],
    "configuration": {
      "title": "Orhunca",
      "properties": {
        "orhunca.derleyiciYolu": {
          "type": "string",
          "default": "orhunca",
          "description": "orhunca komutunun yolu (PATH'te değilse tam yolunu yazın)."
        }
      }
    },
    "configurationDefaults": {
      "[orhunca]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false
      }
    },
    "breakpoints": [
      {
        "language": "orhunca"
      }
    ],
    "debuggers": [
      {
        "type": "orhunca",
        "label": "Orhunca",
        "languages": [
          "orhunca"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Çalıştırılacak .ohc dosyası ya da proje klasörü",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Programın argümanları",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Çalışma klasörü (varsayılan: dosyanın klasörü)"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "İlk satırda dur",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "orhunca",
            "request": "launch",
            "name": "Orhunca: bu dosyayı çalıştır",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Orhunca: Çalıştır ve hata ayıkla",
            "description": "Bir .ohc dosyasını hata ayıklayıcıyla çalıştırır",
            "body": {
              "type": "orhunca",
              "request": "launch",
              "name": "Orhunca",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
