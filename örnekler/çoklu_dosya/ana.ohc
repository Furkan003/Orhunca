# Başka dosyalardaki işlev, fiil ve sabitler `kullan` ile alınır.
kullan "araçlar/fiyat.ohc"

sepet = {"kalem": 12.5, "defter": 30, "silgi": 4.75}
ara_toplam = 0.0
her ürün için sepetten:
    ara_toplam += sepet[ürün]
"Ara toplam: " + ara_toplam'ı yaz.
"KDV dahil: " + (ara_toplam'a kdv_ekle)'yi yaz.
"Mağaza: " + MAĞAZA'yı yaz.
